{
  "name": "hostdb",
  "version": "0.39.0",
  "description": "Pre-built database binaries for multiple platforms, plus a typed registry library for resolving versions and download URLs offline.",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./databases.json": "./databases.json",
    "./releases.json": "./releases.json",
    "./downloads.json": "./downloads.json"
  },
  "bin": {
    "hostdb": "./bin/cli.js"
  },
  "author": "Bob Bass",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/robertjbass/hostdb.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "bin",
    "cli",
    "dist",
    "databases.json",
    "releases.json",
    "downloads.json"
  ],
  "scripts": {
    "add:engine": "tsx scripts/add-engine.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "build:releases": "tsx scripts/build-releases-json.ts",
    "prepare": "pnpm build",
    "prepublishOnly": "pnpm build",
    "check:dylibs": "builds/common/check-macos-dylibs.sh",
    "checksums:populate": "tsx scripts/populate-checksums.ts",
    "dbs": "tsx scripts/list-databases.ts",
    "delete:releases": "tsx scripts/delete-releases.ts",
    "download:clickhouse": "tsx builds/clickhouse/download.ts",
    "download:cockroachdb": "tsx builds/cockroachdb/download.ts",
    "download:couchdb": "tsx builds/couchdb/download.ts",
    "download:duckdb": "tsx builds/duckdb/download.ts",
    "download:ferretdb": "tsx builds/ferretdb/download.ts",
    "download:influxdb": "tsx builds/influxdb/download.ts",
    "download:libsql": "tsx builds/libsql/download.ts",
    "download:mariadb": "tsx builds/mariadb/download.ts",
    "download:meilisearch": "tsx builds/meilisearch/download.ts",
    "download:mongodb": "tsx builds/mongodb/download.ts",
    "download:mysql": "tsx builds/mysql/download.ts",
    "download:postgresql": "tsx builds/postgresql/download.ts",
    "download:postgresql-documentdb": "tsx builds/postgresql-documentdb/download.ts",
    "download:qdrant": "tsx builds/qdrant/download.ts",
    "download:questdb": "tsx builds/questdb/download.ts",
    "download:redis": "tsx builds/redis/download.ts",
    "download:sqlite": "tsx builds/sqlite/download.ts",
    "download:surrealdb": "tsx builds/surrealdb/download.ts",
    "download:tigerbeetle": "tsx builds/tigerbeetle/download.ts",
    "download:typedb": "tsx builds/typedb/download.ts",
    "download:valkey": "tsx builds/valkey/download.ts",
    "download:weaviate": "tsx builds/weaviate/download.ts",
    "edb:fileids": "tsx scripts/fetch-edb-fileids.ts",
    "format": "prettier --write .",
    "lint": "tsc --noEmit && eslint .",
    "migrate:r2": "tsx scripts/migrate-to-r2.ts",
    "prep": "tsx scripts/prep.ts",
    "repair:checksums": "tsx scripts/repair-checksums.ts",
    "start": "tsx cli/bin.ts",
    "sync:versions": "tsx scripts/sync-versions.ts",
    "upload:r2": "tsx scripts/upload-to-r2.ts",
    "audit:r2-orphans": "tsx scripts/audit-r2-orphans.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.990.0",
    "@eslint/js": "^9.17.0",
    "@inquirer/prompts": "^8.2.1",
    "@types/node": "^22.10.0",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "eslint": "^9.17.0",
    "ora": "^9.3.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "yaml": "^2.8.2"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}
