# Minimum macOS for every hostdb macOS binary we compile (darwin-arm64 and darwin-x64).
#
# Sourced by every macOS build (workflow steps and builds/*/build-macos.sh) and
# read by builds/common/check-macos-minos.sh as its default ceiling. Without an
# explicit target, clang stamps the BUILD MACHINE's macOS version as the
# minimum, so a runner image upgrade silently drops users on older macOS.
#
# 14.0 is the floor of the published darwin-arm64 source builds (built on
# macos-14). Raising it drops support for macOS 14 users: make that a
# deliberate, documented decision, never a side effect of a runner change.
export MACOSX_DEPLOYMENT_TARGET=14.0
